{
  "$schema": "https://schemas.macro-deck.app/plugin-manifest-v1.schema.json",
  "manifestVersion": 1,
  "id": "com.eddyvenus.vikunja",
  "name": "Vikunja Tasks",
  "version": "1.0.0",
  "description": "Show your open Vikunja tasks in a Macro Deck widget and check them off. Requires a Vikunja 0.24.0+ server you can reach and an API token with Tasks read and update access. Lists the open tasks of all your projects (up to 200). Windows x64 only.",
  "icon": "Assets/icon.svg",
  "entrypoints": {
    "win-x64": {
      "executable": "runtimes/win-x64/VikunjaPlugin.dll",
      "runtime": {
        "kind": "FrameworkDependent",
        "dotnetVersion": "10.0"
      }
    }
  },
  "publisher": {
    "name": "EddyVenus"
  },
  "license": "MIT",
  "repository": "https://github.com/EddyVenus/Vikunja-MD3-Plugin",
  "compatibility": {
    "macroDeck": ">=3.0.0-0"
  },
  "ai": {
    "interaction": false,
    "generatedContent": false,
    "generatedAssets": true
  }
}
